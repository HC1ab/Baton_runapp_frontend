# ============================================================
#  RunApp — dart-define 환경변수 양식
#  이 파일은 Git에 커밋됩니다 (예시값만 포함, 실제 키 없음)
#  실제 사용은 .env.dev / .env.prod 파일을 복사해서 사용하세요
# ============================================================

# ── 앱 모드 ──────────────────────────────────────────────────
# 개발 모드 여부 (true: Mock 서비스 사용, false: 실제 서버 사용)
IS_DEV=true

# ── API 서버 ──────────────────────────────────────────────────
# 백엔드 서버 Base URL
# Android 에뮬레이터: http://10.0.2.2:8080
# iOS 시뮬레이터:     http://127.0.0.1:8080
# 실제 서버:          https://api.your-domain.com
API_BASE_URL=http://10.0.2.2:8080

# ── 네이버 지도 ───────────────────────────────────────────────
# 네이버 클라우드 플랫폼 > AI·NAVER API > Maps > Mobile Dynamic Map
# https://console.ncloud.com
NAVER_MAP_CLIENT_ID=your_naver_map_client_id_here
