# ============================================================
#  RunApp .gitignore
# ============================================================

# ── 환경변수 (실제 키 포함 — 절대 커밋 금지) ────────────────
.env.dev
.env.prod
# .env.example 은 예시 파일이므로 커밋 허용

# ── Firebase (API key, project ID 포함 — 절대 커밋 금지) ─────
google-services.json
lib/firebase_options.dart
# firebase.json 은 프로젝트 설정만 포함 — 필요 시 커밋 허용

# ── Flutter/Dart ─────────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# ── Android ──────────────────────────────────────────────────
/android/app/debug
/android/app/profile
/android/app/release
**/android/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
# 서명 키 (절대 커밋 금지)
*.jks
*.keystore
key.properties

